{
  "version": 1,
  "app": "qyunslation",
  "host": "translate.qyunsgen.com",
  "aliases": ["office.qyunsgen.com"],
  "upstreams": { "sidecar": "127.0.0.1:8010" },
  "routes": [
    { "match": "/", "action": "redirect", "status": 302, "location": "/next/" },
    { "match": "/next, /next/*", "upstream": "sidecar", "read_timeout": "60s", "write_timeout": "60s" },
    { "match": "/app-assets/*", "upstream": "sidecar", "cache_control": "public, max-age=31536000, immutable" },
    { "match": "/auth, /auth/*", "upstream": "sidecar", "read_timeout": "30s", "write_timeout": "30s", "cache_control": "no-store" },
    { "match": "/api/v1, /api/v1/*", "upstream": "sidecar", "read_timeout": "120s", "write_timeout": "120s" },
    { "match": "everything else", "action": "redirect", "status": 302, "location": "https://translate.qyunsgen.com/next/" }
  ],
  "security_headers": ["Strict-Transport-Security", "X-Content-Type-Options", "X-Frame-Options"],
  "oidc": {
    "issuer": "https://auth.qyunsgen.com/application/o/qyunslation/",
    "client_id": "qyunslation",
    "redirect_uri": "https://translate.qyunsgen.com/auth/callback",
    "scopes": ["openid", "profile", "email", "tenant", "roles"],
    "vue_beta_group": "qyunslation-vue-beta",
    "session": { "idle_minutes_default": 60, "absolute_hours_default": 12, "cookie": "qyunslation_session", "csrf_cookie": "qyunslation_csrf" }
  },
  "logout": {
    "bff": { "method": "POST", "path": "/auth/logout", "csrf_header": "X-CSRF-Token" },
    "chain_route": "/next/qyuns-logout",
    "end_session": "https://auth.qyunsgen.com/application/o/qyunslation/end-session/",
    "next_hosts": ["apps.qyunsgen.com", "watch.qyunsgen.com", "weknora.qyunsgen.com", "translate.qyunsgen.com"]
  },
  "appbar": { "current_app": "translate", "theme": "light" }
}
