{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qyunslation.local/plan076/ad-annotations.schema.json",
  "type": "object",
  "required": ["concepts", "facts"],
  "properties": {
    "concepts": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "additionalProperties": true,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["source_span", "target_terms", "criticality"],
      "properties": {
        "concept_id": {"type": "string"},
        "fact_id": {"type": "string"},
        "type": {"type": "string"},
        "source_span": {"type": "string", "minLength": 1},
        "target_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowed_aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "criticality": {"enum": ["high", "medium", "low"]}
      },
      "additionalProperties": true
    }
  }
}
