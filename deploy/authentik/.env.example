# PLAN-054 Authentik — 复制为 deploy/authentik/.env（gitignore，勿入库）
#
# 生成示例：
#   PG_PASS=$(openssl rand -base64 36 | tr -d '\n')
#   AUTHENTIK_SECRET_KEY=$(openssl rand -base64 60 | tr -d '\n')
#   AUTHENTIK_BOOTSTRAP_TOKEN=$(openssl rand -base64 32 | tr -d '\n')
#   QYUNSLATION_OIDC_CLIENT_SECRET=$(openssl rand -base64 32 | tr -d '\n')

PG_USER=authentik
PG_DB=authentik
PG_PASS=CHANGE_ME_PG_PASS
AUTHENTIK_SECRET_KEY=CHANGE_ME_SECRET_KEY

# 首次引导管理员（只首次生效）
AUTHENTIK_BOOTSTRAP_EMAIL=admin@qyunsgen.com
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD
AUTHENTIK_BOOTSTRAP_TOKEN=CHANGE_ME_BOOTSTRAP_TOKEN

# 公网主机名（issuer / 反代后的外部 URL）
AUTHENTIK_HOST=https://auth.qyunsgen.com/

# OAuth2 provider client_secret（blueprint !Env 读取；同时供 verify M2M）
QYUNSLATION_OIDC_CLIENT_ID=qyunslation
QYUNSLATION_OIDC_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET

AUTHENTIK_TAG=2025.10.4
COMPOSE_PORT_HTTP=9000
