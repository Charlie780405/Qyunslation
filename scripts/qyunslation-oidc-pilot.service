[Unit]
Description=Qyunslation PLAN-034h localhost OIDC pilot (JWKS + mint)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/dev/qyunslation
EnvironmentFile=/home/dev/pdf2zh/office.env
Environment=PATH=/home/dev/qyunslation/.venv/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/dev/qyunslation
Environment=QYUNSLATION_OIDC_DATA_DIR=/home/dev/qyunslation/var/oidc
ExecStart=/home/dev/qyunslation/.venv/bin/python /home/dev/qyunslation/scripts/plan034h-pilot-oidc.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
