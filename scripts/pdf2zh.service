ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-no-store.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-css-has-fix.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-viewer.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-preview-dpi.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-fidelity-033h.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-045c-sanitize.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-046b-para-merge.py
