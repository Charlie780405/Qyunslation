[Unit]
Description=PDFMathTranslate-next (BabelDOC) WebUI for translate.qyunsgen.com
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/dev/pdf2zh
Environment=PATH=/home/dev/.local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/dev/qyunslation
Environment=PDF2ZH_LLM_BATCH_PARAS=3
Environment=PDF2ZH_LLM_BATCH_TOKENS=120
EnvironmentFile=-/home/dev/pdf2zh/office.env
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-throughput.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-038g-session-cancel.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-brand.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-hpd.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-docimg.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-ocr-base.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-office-route.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-docprofile.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-downloads.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-office-preview.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-settings-inline.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-dual-preview.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-layout-polish.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-adv-options.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-left-dock.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-prescan.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-stale-guard.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-040a-auth-shell.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-040b-upload-settle.py
ExecStartPre=/usr/bin/python3 /home/dev/qyunslation/scripts/apply-pdf2zh-040d-refresh-keep.py
