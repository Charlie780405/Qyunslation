# pdf2zh 旁路归档（PLAN-002e）
# 复制为 /home/dev/pdf2zh/archive.env 并填入 MinIO 密钥
# 或运行: bash scripts/deploy-pdf2zh-archive.sh

PDF2ZH_ARCHIVE_WATCH_DIR=/home/dev/pdf2zh/out
PDF2ZH_ARCHIVE_STATE_DB=/home/dev/pdf2zh/.archive-state.db
PDF2ZH_ARCHIVE_INDEX_DB=/home/dev/pdf2zh/archive/index.db
PDF2ZH_ARCHIVE_LOCAL_ROOT=/home/dev/pdf2zh/archive
PDF2ZH_ARCHIVE_STORAGE=minio

# 宿主机访问 qyunsgen-minio（MINIO_API_PORT，默认 9002）
PDF2ZH_MINIO_ENDPOINT=127.0.0.1:9002
PDF2ZH_MINIO_ACCESS_KEY=
PDF2ZH_MINIO_SECRET_KEY=
PDF2ZH_MINIO_BUCKET=translate-docs
PDF2ZH_MINIO_PREFIX=pdf2zh
PDF2ZH_MINIO_SECURE=false

PDF2ZH_ARCHIVE_POLL_SECONDS=5
PDF2ZH_ARCHIVE_SETTLE_SECONDS=8
