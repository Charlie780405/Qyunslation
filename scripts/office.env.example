# PLAN-005b office sidecar env（复制为 /home/dev/pdf2zh/office.env）
DOCUTRANSLATE_BASE_URL=http://100.67.66.123:11434/v1
DOCUTRANSLATE_API_KEY=ollama
DOCUTRANSLATE_MODEL_ID=qwen3.6:35b-a3b
DOCUTRANSLATE_TEMPERATURE=0
DOCUTRANSLATE_CONCURRENT=4
DOCUTRANSLATE_THINKING=disable
DOCUTRANSLATE_CUSTOM_PROMPT=/no_think You are a professional, authentic machine translation engine.
DOCUTRANSLATE_GLOSSARY_GENERATE_ENABLE=false
DOCUTRANSLATE_ENV_FORCE_OVERRIDE=true
DOCUTRANSLATE_WEB_SKIP_VALIDATION=true
DOCUTRANSLATE_TO_LANG=简体中文
QYUNSLATION_IMAGE_OVERLAY=1
QYUNSLATION_GLOSSARY_CSV=/home/dev/pdf2zh/glossaries/qx027n.csv
QYUNSLATION_OFFICE_OUT=/home/dev/pdf2zh/office_out

# PLAN-034 / PLAN-054 SaaS（真实值只写本机 office.env / deploy/authentik/.env，勿入库）
# QYUNSLATION_DATABASE_URL=postgresql+psycopg://qyunslation:CHANGE_ME@127.0.0.1:5433/qyunslation
# QYUNSLATION_OIDC_ISSUER=https://auth.qyunsgen.com/application/o/qyunslation/
# QYUNSLATION_OIDC_AUDIENCE=qyunslation
# # JWKS：公网 DNS 就绪后可改 https://auth.qyunsgen.com/.../jwks/；本机同机可用 :9000
# QYUNSLATION_OIDC_JWKS_URL=http://127.0.0.1:9000/application/o/qyunslation/jwks/
# QYUNSLATION_OIDC_TENANT_CLAIM=tenant
# QYUNSLATION_ENV=production
# M2M client_secret 见 deploy/authentik/.env（QYUNSLATION_OIDC_CLIENT_SECRET）

# PLAN-055 TM 语义建议（与 Hermes embed-mcp 同名；真实值写本机 office.env）
# OLLAMA_EMBED_URL=http://100.67.66.123:11434
# OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_EMBED_DIM=1024
# OLLAMA_EMBED_TIMEOUT=30
# QYUNSLATION_TM_SEMANTIC_THRESHOLD=0.88

# PLAN-060 公司共享术语工作台（两个本机服务共同读取本文件；真实值只在部署环境）
# 生成一次高熵随机值，并同时提供给 pdf2zh.service 与 qyunslation-office.service。
# QYUNSLATION_TERM_BRIDGE_SECRET=CHANGE_ME_GENERATE_32_BYTES_OR_MORE
# QYUNSLATION_WORKBENCH_TENANT=your-company-tenant
# QYUNSLATION_WORKBENCH_BRIDGE_URL=http://127.0.0.1:8010/internal/workbench/v1
# 译前术语解析额外 OCR 的单文件/Office/PDF 图片资产上限；0 可在资源紧张时关闭。
# QYUNSLATION_TERM_POLICY_OCR_IMAGE_LIMIT=12
# 管理员授予/撤销仅可在主机执行 scripts/manage-term-admin.py；不要提供给浏览器或 Caddy。
# QYUNSLATION_TERM_ROLE_ADMIN_TOKEN=CHANGE_ME_SEPARATE_DEPLOYMENT_SECRET
