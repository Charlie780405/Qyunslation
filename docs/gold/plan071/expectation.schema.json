{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qyunslation.local/schemas/plan071-expectation.json",
  "title": "PLAN-071 gold expectation",
  "type": "object",
  "required": [
    "id",
    "format",
    "page_or_slide_count",
    "objects",
    "atomic_spans",
    "quality_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "format": {
      "type": "string",
      "enum": ["pdf_text", "pdf_scan", "pdf_table_dense", "pdf_figure_dense", "docx", "pptx", "image"]
    },
    "lang_pair": { "type": "string" },
    "page_or_slide_count": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog_id": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "relpath": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "objects": {
      "type": "object",
      "required": ["paragraphs_min", "tables", "figures", "preserve"],
      "additionalProperties": false,
      "properties": {
        "paragraphs_min": { "type": "integer", "minimum": 0 },
        "tables": { "type": "integer", "minimum": 0 },
        "figures": { "type": "integer", "minimum": 0 },
        "preserve": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "count_min"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["logo", "seal", "signature", "agency_mark"]
              },
              "count_min": { "type": "integer", "minimum": 0 },
              "hash_required": { "type": "boolean" }
            }
          }
        },
        "table_structure": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "rows", "cols"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "rows": { "type": "integer", "minimum": 1 },
              "cols": { "type": "integer", "minimum": 1 },
              "merges": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "atomic_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "examples"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["email", "url", "pind", "ind", "reference_id", "dose", "number", "ordinal", "regulatory_cite"]
          },
          "examples": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "layout_baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbid_substrings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bbox_tolerance_pt": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "quality_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "rule"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocker", "warning", "info"] },
          "rule": { "type": "string" }
        }
      }
    }
  }
}
